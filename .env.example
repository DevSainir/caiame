# Личный токен Figma для экстрактора макета (tools/figma-extract).
# Создаётся в Settings → Security → Personal access tokens.
FIGMA_TOKEN=figd_your_token_here
FIGMA_FILE_KEY=Ldhh9PSa6tgaAvPnUKUXDo

# Хранилище материалов лекций. Локально это MinIO из docker-compose и значения по
# умолчанию подходят; на сервере — отдельный бакет R2, НЕ тот, в котором лежат бэкапы.
# Бакет закрыт целиком, и ему нужен CORS на домен сайта: файл идёт из браузера прямо
# туда, и без разрешённого источника браузер этот запрос не отправит.
MEDIA_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_BUCKET_PRIVATE=caiame-private
