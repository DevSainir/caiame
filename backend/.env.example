DATABASE_URL=postgresql+asyncpg://caiame:caiame@localhost:5433/caiame
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=["http://localhost:5173"]

# В проде обязателен: с дефолтным значением приложение откажется стартовать,
# потому что публичный секрет подписи — это ключ для выпуска чужих сессий.
ENVIRONMENT=development
JWT_SECRET=generate-me-with-openssl-rand-hex-32
COOKIE_SECURE=false
