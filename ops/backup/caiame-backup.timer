[Unit]
Description=Ежедневный запуск резервного копирования Caiame

[Timer]
# 03:00 UTC — время наименьшей нагрузки. По воскресеньям тот же запуск делает
# недельную копию и проверяет её восстановлением, первого числа — месячную.
OnCalendar=*-*-* 03:00:00
# Пропущенный запуск (сервер был выключен) выполняется при следующем старте,
# иначе выключенная на сутки машина молча теряет день истории.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
